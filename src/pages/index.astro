---
import '../styles/global.css';
import CompanyList from '../components/CompanyList.astro';
import ConversationList from '../components/ConversationList.astro';
import ChatArea from '../components/ChatArea.astro';
---

<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartClic Chat Viewer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="app-container">
        <aside class="sidebar companies-sidebar">
            <CompanyList />
        </aside>
        
        <aside class="sidebar conversations-sidebar">
            <ConversationList />
        </aside>

        <main class="chat-area">
            <ChatArea />
        </main>
    </div>
    <script src="../scripts/main.js"></script>
</body>
</html>

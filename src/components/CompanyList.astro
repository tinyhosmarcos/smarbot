---
---
<div class="sidebar-header">
    <h2>Empresas</h2>
    <div class="date-controls">
        <div class="input-group">
            <label for="start-date">Desde</label>
            <input type="date" id="start-date">
        </div>
        <div class="input-group">
            <label for="end-date">Hasta</label>
            <input type="date" id="end-date">
        </div>
        <button id="search-btn" class="btn-primary">Consultar</button>
        
        <div class="input-group" style="margin-top: 1rem; border-top: 1px solid #eee; padding-top: 1rem;">
            <input type="text" id="company-filter" placeholder="Filtrar empresas..." style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
        </div>
    </div>
</div>
<div id="company-list" class="list-container">
    <div class="empty-list">Selecciona fechas para buscar</div>
</div>
